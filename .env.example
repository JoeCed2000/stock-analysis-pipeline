# Stock Analysis Pipeline — Environment Variables
# Copy this to .env and fill in your keys

# Alpha Vantage API — free tier at https://alphavantage.co/support/#api-key
# Used for earnings call transcripts (25 req/day free)
ALPHA_VANTAGE_API_KEY=your_key_here

# RapidAPI Seeking Alpha — primary source for earnings call transcripts
RAPIDAPI_KEY=your_key_here

# Finnhub API — free tier at https://finnhub.io/
# Used for financial data, company profiles, news
FINNHUB_API_KEY=your_key_here
