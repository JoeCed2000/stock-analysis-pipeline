{
  "name": "stock-analysis-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "VITE_API_URL=/stock-analysis/api vite build",
    "preview": "vite preview",
    "recette": "cd .. && .venv/bin/pytest tests_e2e/ -v",
    "recette:quick": "cd .. && .venv/bin/pytest tests_e2e/ -v -k 'not analysis_completes and not download_dossier'",
    "recette:full": "cd .. && .venv/bin/pytest tests_e2e/ -v"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.0"
  }
}
